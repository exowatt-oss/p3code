{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "docs": {
      "type": "local",
      "command": ["npx", "-y", "@example/docs"],
      "environment": {
        "DOCS_TOKEN": "${DOCS_TOKEN}",
      },
      "enabled": true,
    },
    "linear": {
      "type": "remote",
      "url": "https://mcp.example.com",
      "enabled": false,
    },
  },
}
